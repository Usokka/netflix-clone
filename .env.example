# --- DATABASE CONFIGURATION (PostgreSQL) ---
# These values configure the netflix-db container and the api-gateway access
DB_USER=postgres
DB_PASSWORD=your_secure_db_password_here

# --- CACHE & SESSION CONFIGURATION (Redis) ---
# Password required to secure your local Redis instance
REDIS_PASSWORD=your_secure_redis_password_here

# --- SECURITY CONFIGURATION (JWT / Spring Boot Backend) ---
# Token validity duration specified in milliseconds
# 900000 ms = 15 minutes (Access Token)
JWT_ACCESS_EXPIRATION=900000
# 604800000 ms = 7 days (Refresh Token)
JWT_REFRESH_EXPIRATION=604800000

# --- EXPOSED PORTS REFERENCE (For information only) ---
# Frontend Next.js       -> http://localhost:3000
# API Gateway Spring Boot -> http://localhost:8080
# Streaming Engine C++   -> http://localhost:8081