# --- DATABASE CONFIGURATION (PostgreSQL) ---
# These values configure the database and backend-api access
DB_USER=postgres
DB_PASSWORD=your_secure_db_password_here

# --- CACHE & SESSION CONFIGURATION (Redis) ---
# Password required to secure your local Redis instance
REDIS_PASSWORD=your_secure_redis_password_here

# The demo profile loads the Flyway demo catalog. Leave empty in production.
SPRING_PROFILES_ACTIVE=demo

# --- SECURITY CONFIGURATION (JWT / Spring Boot Backend) ---
# Token validity duration specified in milliseconds
# 900000 ms = 15 minutes (Access Token)
JWT_ACCESS_EXPIRATION=900000
# 604800000 ms = 7 days (Refresh Token)
JWT_REFRESH_EXPIRATION=604800000

# --- DEMO SUBSCRIPTION ACTIVATION ---
# Keep this enabled only for a local demo. A production deployment must use a
# payment provider and activate subscriptions only after a verified webhook.
SUBSCRIPTION_DEMO_ACTIVATION_ENABLED=true

# Set to true whenever the application is served over HTTPS.
COOKIE_SECURE=false

# Comma-separated public frontend origins. Use the real HTTPS origin in production.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- EXPOSED PORT ---
# Frontend Next.js -> http://localhost:3000
# Backend, streaming, PostgreSQL and Redis are internal Compose services.
